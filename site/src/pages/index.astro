---
import { MarkdownBlock } from 'astro-markdown-block'
import Snippet from '../components/Snippet.astro'
import Layout from '../layouts/Layout.astro'
import {
  authorUrl,
  canonicalFor,
  homePath,
  licenseUrl,
  pkgInfo,
  repoUrl,
  siteDescription,
  siteTitle,
} from '../lib/site'
import readme from '../samples/readme.md?raw'

if (!Astro.site) throw new Error('Set site in astro.config')

const home = homePath()
const canonical = canonicalFor(home, Astro.site)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: pkgInfo.name,
  description: siteDescription,
  url: canonical,
  codeRepository: repoUrl,
  programmingLanguage: 'TypeScript',
  license: 'https://opensource.org/licenses/MIT',
  version: pkgInfo.version,
  author: {
    '@type': 'Person',
    name: 'Vatsal Trivedi',
    url: authorUrl,
  },
}

// Inner SVG markup for 24x24 stroke icons.
const features = [
  {
    title: 'Preview and source',
    body: 'Flip between rendered Markdown and the raw text.',
    icon: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  },
  {
    title: 'One-click copy',
    body: 'Copies the original Markdown, not the rendered HTML.',
    icon: '<rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>',
  },
  {
    title: 'GitHub Flavored Markdown',
    body: 'Tables, task lists, and strikethrough work out of the box.',
    icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/>',
  },
  {
    title: 'Themeable',
    body: 'CSS variables, with light and dark built in.',
    icon: '<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M2 14h4M10 8h4M18 16h4"/>',
  },
  {
    title: 'Extensible',
    body: 'Bring your own remark and rehype plugins and renderers.',
    icon: '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
  },
  {
    title: 'Astro and React',
    body: 'Works in .astro, .mdx, and any React 18+ app.',
    icon: '<path d="m12 2 10 5-10 5L2 7z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/>',
  },
]

const astroUsage = `---
import { MarkdownBlock } from 'astro-markdown-block'
import 'astro-markdown-block/styles.css'
import notes from './notes.md?raw'
---

<MarkdownBlock client:visible title="Notes" source={notes} />`

const mdxUsage = `import { MarkdownBlock } from 'astro-markdown-block'
import 'astro-markdown-block/styles.css'
import notes from './notes.md?raw'

<MarkdownBlock client:visible title="Notes" source={notes} />`

const reactUsage = `import { MarkdownBlock } from 'astro-markdown-block'
import 'astro-markdown-block/styles.css'

const notes = \`# Notes

Read the diff first, then report one problem at a time.\`

export function Notes() {
  return <MarkdownBlock title="Notes" source={notes} />
}`

const next = [
  {
    href: `${home}playground/`,
    title: 'Playground',
    body: 'Edit Markdown and watch the block update.',
  },
  {
    href: `${home}examples/`,
    title: 'Examples',
    body: 'Prompts, READMEs, release notes, and custom themes.',
  },
  {
    href: `${home}api/`,
    title: 'API',
    body: 'Every prop and CSS variable.',
  },
]
---

<Layout
  title={siteTitle}
  description={siteDescription}
  canonical={canonical}
  jsonLd={jsonLd}
  current="home"
>
  <main id="main">
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="pills">
            <span class="pill">v{pkgInfo.version}</span>
            <a class="pill" href={licenseUrl}>
              {pkgInfo.license}
            </a>
            <span class="pill">Astro + React</span>
          </p>
          <h1>Markdown people can read and copy.</h1>
          <p class="lede">
            A Markdown block for Astro and React. Show the rendered version,
            flip to the source, and copy it in one click.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#install">
              Get started
            </a>
            <a class="button" href={`${home}playground/`}>
              Open playground
            </a>
          </div>
        </div>
        <div class="hero-stage frame">
          <MarkdownBlock
            client:load
            title="README.md"
            source={readme}
            height="22rem"
          />
          <p class="hint">
            Try the <strong>Markdown</strong> button and the copy icon.
          </p>
        </div>
      </div>
    </section>

    <section class="band band-alt">
      <div class="wrap">
        <h2>What you get</h2>
        <ul class="feature-grid">
          {features.map((feature) => (
            <li class="feature">
              <span class="feature-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={feature.icon}
                />
              </span>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="band" id="install">
      <div class="wrap">
        <h2>Install</h2>
        <p class="section-lead">Three steps. In a React app, skip step 2.</p>
        <div class="step">
          <h3>
            <span class="step-index">1</span> Add the package
          </h3>
          <Snippet
            id="install-cmd"
            code={`npm install ${pkgInfo.name}`}
            lang="sh"
          />
        </div>
        <div class="step">
          <h3>
            <span class="step-index">2</span> Add React to Astro
          </h3>
          <p>The buttons are a React island, so Astro needs React.</p>
          <Snippet id="astro-add" code="npx astro add react" lang="sh" />
        </div>
        <div class="step">
          <h3>
            <span class="step-index">3</span> Use it
          </h3>
          <p>
            Import the component and its CSS, then pass Markdown as{' '}
            <code>source</code>. <code>?raw</code> loads a <code>.md</code> file
            as a string. <code>client:visible</code> turns on the buttons when
            the block scrolls into view.
          </p>
          <fieldset class="tabs">
            <legend class="sr-only">Usage examples</legend>
            <input
              class="tab-inputs"
              type="radio"
              name="usage"
              id="usage-astro"
              checked
            />
            <input
              class="tab-inputs"
              type="radio"
              name="usage"
              id="usage-mdx"
            />
            <input
              class="tab-inputs"
              type="radio"
              name="usage"
              id="usage-react"
            />
            <div class="tablist">
              <label for="usage-astro">Astro</label>
              <label for="usage-mdx">MDX</label>
              <label for="usage-react">React</label>
            </div>
            <div class="tab-panel panel-astro">
              <Snippet id="usage-astro-code" code={astroUsage} lang="astro" />
            </div>
            <div class="tab-panel panel-mdx">
              <Snippet id="usage-mdx-code" code={mdxUsage} lang="mdx" />
            </div>
            <div class="tab-panel panel-react">
              <Snippet id="usage-react-code" code={reactUsage} lang="tsx" />
            </div>
          </fieldset>
        </div>
        <p class="note">
          To restyle it, set <code>--amb-*</code> variables on a class and pass
          it as <code>className</code>. See the{' '}
          <a href={`${home}examples/`}>custom theme example</a> and the{' '}
          <a href={`${home}api/#variables`}>variable list</a>.
        </p>
      </div>
    </section>

    <section class="band band-alt">
      <div class="wrap">
        <h2>Where next</h2>
        <ul class="link-grid">
          {next.map((item) => (
            <li>
              <a href={item.href}>
                <strong>{item.title} →</strong>
                <span>{item.body}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</Layout>
